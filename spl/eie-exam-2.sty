%------------------------------------------------------------------------------
%                         Settings for the exam class
% ------------------------------------------------------------------------------

% Extra space placed before each new question, so that a question that begins
% part-way down a page is clearly separated from the one before it.  This is
% added to \itemsep, and so it is inserted only between the items of the
% questions list.  Glue at the top of a page is discarded by \TeX{}, so a
% question that happens to begin a page is not given any extra space above it.
\newlength{\eeQuestionPreSkip}
\setlength{\eeQuestionPreSkip}{5.4ex} % 10mm at 11pt

% Paragraph spacing inside a question, i.e. the space produced by a blank line
% in the source.  \startquestionformat sets \parskip for paragraphs that are
% not inside a list, but the parts and subparts lists take their paragraph
% spacing from the list parameters instead, and \list does that by copying
% \parsep into \parskip *after* it has run \partshook and \subpartshook.
% Setting \parskip in those hooks is therefore discarded without warning;
% \parsep is the length that has to be set.  Without this, a blank line inside
% a part adds only the 2pt of exam.cls's list \parsep (and nothing at all
% inside a subpart, where \parsep is 0pt), so the paragraphs of a part run
% together.  Note that the paragraph spacing between the parts themselves is
% max(\parsep, \itemsep), so this also sets the minimum gap between one part
% and the next.
\newlength{\eePartParagraphSkip}
\setlength{\eePartParagraphSkip}{2.3ex} % as \startquestionformat's \parskip

% remove question indentation
\renewcommand{\questionshook}{%
  \setlength{\leftmargin}{0pt}%
  \setlength{\labelwidth}{-\labelsep}%
  \addtolength{\itemsep}{\eeQuestionPreSkip}%
}

% Set the question title format
% https://tex.stackexchange.com/questions/353142/adjust-vertical-space-between-question-title-and-text-in-exam-class
\qformat{\textbf{Question \thequestion}
  \hfill
  \vrule depth 1em width 0pt
} % depth is the space between Question # and the first paragraph

% Put the mark allocation on the right
\setlength{\rightpointsmargin}{2.5cm} % don't push marks into margin
\pointsdroppedatright % put marks on the right
\marksnotpoints % use "marks" instead of "points"
\marginpointname{ \points} % print "marks" after the mark value

%------------------------------------------------------------------------------
%                        Dropping the mark allocation
%------------------------------------------------------------------------------
% \dropmarks and \dropmarksinline are written directly after the full stop that
% ends the question or on the next line.  The block of marks is roughly 2cm wide,
% so on a long final
% line it would collide with the text of the question.  Both commands therefore
% measure how much of the final line the question has already used.  \dropmarksinline
% keeps the marks on that line only when it is sufficiently short; otherwise it
% uses the same below-line placement rules as \dropmarks.
%
%   \dropmarksinline           the marks stay on the final line, if that line is
%                              fairly short;
%   \droppointsslightlybelow   the marks go on the next line but are closer to the
%                              question, if the final line has sufficient room;
%   \droppointsbelow           the marks go a full paragraph below the question,
%                              if there is no room for them beside the text.
%
% Each placement separates the block of marks from whatever follows it -- the
% next paragraph of the question, or the next question -- by a rigid \kern, so
% that the list spacing that follows is added on top of it rather than replacing
% it: see \eeMarkAfterSkip for the two below-line placements and
% \eeMarkInlineAfterSkip for the inline placement.
%
% Writing \TabPrevPos for the natural width of the last line of the question, the
% inline choice is made using \eeMarkInlineFraction; if inline placement is
% rejected, the reserved-zone comparison chooses between the two below-line
% placements:
%
%   \TabPrevPos = 0                     -> \droppointsbelow,
%   \TabPrevPos < \eeMarkInlineFraction\linewidth
%                                       -> \droppoints,
%   \TabPrevPos < \linewidth - \eeMarkBlockWidth - \eeMarkSafetyGap
%                                       -> \droppointsslightlybelow,
%   otherwise (the line has run into the space reserved for the marks)
%                                       -> \droppointsbelow.
%
% \TabPrevPos is zero when the measurement could not be taken, which happens
% when the last line of the question was already full: \tabto then breaks the
% line and starts a new, empty one.  Such a line obviously leaves no room for the
% marks, so they are dropped a full paragraph below.  Without this special case a
% full final line would be mistaken for a very short one, and the marks would be
% placed on top of the text.
%
% The measurement uses the \tabto{\CurrentLineWidth} trick:
% afterwards \TabPrevPos holds the natural width of the last
% line of the current paragraph.  The three commands may also be used directly,
% to override the automatic choice for an unusual layout.
%------------------------------------------------------------------------------

% Width of the block of marks that \droppoints will place.
%
% The spacing lengths in this section are given in font-relative units so that
% they scale with the font size: the vertical skips in ex (the x-height, the
% usual unit for vertical spacing) and the horizontal clearances in em (the
% usual unit for horizontal measurement).  In XCharter at 11pt, 1em = 10.95pt and
% 1ex = 5.267pt, so 1em is about 2.08ex.
\newlength{\eeMarkBlockWidth}

% Free space that must remain beside the marks text, over and above the width of the
% mark block itself, before the marks may share the last line.
\newlength{\eeMarkSafetyGap}
\setlength{\eeMarkSafetyGap}{1.3em} % 5mm at 11pt

% Public tuning value for the "slightly below" placement: the fraction of the
% line that the final line of the question may occupy and the marks still sit
% close below it.  A longer final line reaches across the column in which the
% marks are set, and hugging it makes the marks look as though they belonged to
% that line, so they are dropped \eeMarkParagraphSkip below the question
% instead.  Short final lines are unaffected.
\newcommand{\eeMarkHugFraction}{0.75}

% Public tuning value for \dropmarksinline. The fraction of th line that
% can be occupied and the marks still placed inline. Note, the \dropmarks command
% never places marks inline, because it cannot reliably distinguish a short final
% line of a multi-line paragraph from a short single-line question.
\newcommand{\eeMarkInlineFraction}{0.90}
\newlength{\eeMarkInlineWidth}

% Extra space above the marks for the two "below" placements.
% \droppointsslightlybelow pulls the marks up towards the question so that they
% sit just below it; \droppointsbelow puts them \eeMarkParagraphSkip below it
% (see the note on that length, below).  \eeMarkBelowSkip is left at zero: it
% used to make up for the paragraph skip that \droppointsbelow was documented as
% keeping but never actually had, and that skip is now supplied explicitly.
% Either value may be changed to fine-tune the spacing.
\newlength{\eeMarkSlightlyBelowSkip}
\setlength{\eeMarkSlightlyBelowSkip}{-1.4ex}
\newlength{\eeMarkBelowSkip}
\setlength{\eeMarkBelowSkip}{0ex}

% The drop used by \droppointsbelow: the distance by which the marks are
% pushed below a final line that leaves no room for them beside the text.
% This is held explicitly rather than taken from \parskip, because the
% list environments of exam.cls set \parskip for their own purposes, and inside
% subparts it is 0pt.  Taking it from \parskip would then leave the marks on
% the very next line (differing from \droppointsslightlybelow only by the two
% skips above), so a final line that has run into the marks' column would not
% push them down at all.  The value is a tuning value: it has to be large enough
% for the marks to read as a separate block rather than as part of that final
% line.
\newlength{\eeMarkParagraphSkip}
\setlength{\eeMarkParagraphSkip}{1.45ex}

% Extra space placed after the block of dropped marks, i.e. between the dropped
% marks and whatever follows them (the next paragraph of the question, or the
% next question).  This is a rigid \kern rather than a \vskip: when a question
% is followed by another \question, \@item adds the space between the items with
% \addvspace\itemsep, and \addvspace replaces any glue it finds at the end of the
% list item with the larger of the two.  A \vskip would therefore be swallowed,
% whereas a \kern is not glue, so \itemsep is still added on top of it.
\newlength{\eeMarkAfterSkip}
\setlength{\eeMarkAfterSkip}{1.5ex}

% Extra space placed after the marks when \dropmarksinline has kept them on the
% final line of the question.  The two below-line placements set the marks in a
% line of their own, and it is that line which separates the question from
% whatever follows it; when the marks stay inline nothing is added, so two
% consecutive questions whose marks are inline are set only the ordinary
% paragraph skip apart and read as one block of text.  This length puts back the
% missing line.  It is added with the same rigid \kern as \eeMarkAfterSkip, and
% for the same reason.
\newlength{\eeMarkInlineAfterSkip}
\setlength{\eeMarkInlineAfterSkip}{0.6\baselineskip}

% Measure the block of marks that \droppoints would place.  exam.cls defines
% \padded@point@block when the points of the current question are read; fall back
% to zero width if the question has no points, so that \dropmarks still works.
\newcommand{\eeMarkBlock}{%
  \@ifundefined{padded@point@block}%
  {\setlength{\eeMarkBlockWidth}{\z@}}%
  {\settowidth{\eeMarkBlockWidth}{\padded@point@block}}%
}

% Place the marks below the question.
%
% A zero \TabPrevPos means that the final line was already full: \tabto had to
% end it in order to measure it, and that leaves an empty line behind.  Its only
% contribution to the vertical list is the interline glue before the next line,
% so exactly one \baselineskip is cancelled; the marks are then dropped just as
% they are for any other final line that has no room for them.
%
% Otherwise the marks sit close below the question (\droppointsslightlybelow)
% only when the final line is genuinely short: it must both leave the marks'
% column clear (\eeMarkSafetyGap) and be no more than \eeMarkHugFraction of the
% line width.  A final line that is full, or nearly full, is dropped
% \eeMarkParagraphSkip below the question instead.
\newcommand{\eeDropMarksBelow}{%
  \ifdim\TabPrevPos=\z@
  \par
  \vskip-\baselineskip
  \droppointsbelow
  \else
  \ifdim\TabPrevPos<\dimexpr\linewidth-\eeMarkBlockWidth-\eeMarkSafetyGap\relax
  \ifdim\TabPrevPos<\eeMarkHugFraction\linewidth
  \droppointsslightlybelow
  \else
  \droppointsbelow
  \fi
  \else
  \droppointsbelow
  \fi
  \fi
}

\newcommand{\dropmarksinline}{%
  \TabPrevPos\linewidth
  \tabto{\CurrentLineWidth}%
  \eeMarkBlock
  \setlength{\eeMarkInlineWidth}{\eeMarkInlineFraction\linewidth}%
  \ifdim\TabPrevPos=\z@
  \eeDropMarksBelow
  \else
  \ifdim\TabPrevPos<\eeMarkInlineWidth
  \droppoints
  \kern\eeMarkInlineAfterSkip
  \else
  \eeDropMarksBelow
  \fi
  \fi
}

% Marks on the next line, hugging the question: the paragraph skip is cancelled
% so that only the normal interline space remains.
\newcommand{\droppointsslightlybelow}{%
  \par
  \vskip-\parskip
  \vskip\eeMarkSlightlyBelowSkip
  \noindent\droppoints
  \kern\eeMarkAfterSkip
}

% Marks a full paragraph below the question: \eeMarkParagraphSkip is added
% above the marks (see the note on it above).  The paragraph skip that the list
% inserts between the question and the marks is cancelled first, so that the
% drop is exactly \eeMarkParagraphSkip and does not silently grow when the
% paragraph spacing of the parts and subparts lists is changed (it is now
% \eePartParagraphSkip, which is much larger than the 2pt that used to be in
% force inside a part).
\newcommand{\droppointsbelow}{%
  \par
  \vskip-\parskip
  \vskip\eeMarkParagraphSkip
  \vskip\eeMarkBelowSkip
  \noindent\droppoints
  \kern\eeMarkAfterSkip
}

\newcommand{\dropmarks}{%
  \TabPrevPos\linewidth % pessimistic default if \tabto cannot measure the line
  \tabto{\CurrentLineWidth}% record the width of the last line of the question
  \eeMarkBlock
  \eeDropMarksBelow
}

