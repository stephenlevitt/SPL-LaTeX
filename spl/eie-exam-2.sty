\newcommand{\startquestionformat}{
\renewcommand{\thepartno}{\alph{partno}}
\renewcommand{\partlabel}{\thepartno)}
% \parsep, not \parskip: see the note on \eePartParagraphSkip
\renewcommand{\partshook}{\setlength{\parsep}{\eePartParagraphSkip}}%
\renewcommand{\subpartshook}{\setlength{\parsep}{\eePartParagraphSkip}}%
\setlength{\parskip}{2.3ex} % paragraph spacing outside the lists
}

